    ls_split_path = kHGwlzUrcuWxYGvxpUmmzByNvbZmNu=>split_path( iv_path ).

    delete_subtree(
      iv_path = ls_split_path-path
      iv_name = ls_split_path-name ).

    ri_json = me.

  ENDMETHOD.
