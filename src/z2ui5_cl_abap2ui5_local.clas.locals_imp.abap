CLASS z2ui5_cl_ui5_serializer IMPLEMENTATION.

  METHOD model_for.

    result = NEW z2ui5_cl_ui5_srv_model( attri = container->mt_attri
                                         app   = container->mo_app ).

  ENDMETHOD.

  METHOD narrow.

    result ?= container.

  ENDMETHOD.

  METHOD xml_of_stored.

    DATA lr_stored TYPE REF TO z2ui5_if_ui5_types=>ty_t_attri.

    DATA(lr_live) = container->mt_attri.
    CREATE DATA lr_stored.
    lr_stored->* = model->main_attri_db_rows( ).
    container->mt_attri = lr_stored.
    " CLEANUP, not CATCH: the failure goes on to stringify( ) as it was
    " raised - its first one is the cause the final error chains
    TRY.
        result = xml_of( container ).
      CLEANUP.
        container->mt_attri = lr_live.
    ENDTRY.
    container->mt_attri = lr_live.

  ENDMETHOD.

  METHOD xml_of.

    result = z2ui5_cl_ui5_util_context=>xml_stringify( container ).

  ENDMETHOD.

  METHOD z2ui5_if_ui5_serializer~parse.

    " The transformation needs a CONCRETELY typed target - it rebuilds the
    " object from the class named in the asXML, and a REF TO object gives it
    " nothing to build into. So the typed local is load-bearing, not style.
    DATA lo_cont TYPE REF TO z2ui5_cl_ui5_app_cont.

    z2ui5_cl_ui5_util_context=>xml_parse( EXPORTING xml = val
                                          IMPORTING any = lo_cont ).
    result = lo_cont.

  ENDMETHOD.

  METHOD z2ui5_if_ui5_serializer~stringify.

    DATA(lo_cont) = narrow( container ).
    DATA(lo_model) = model_for( lo_cont ).

    DATA lx_first TYPE REF TO cx_root.

    TRY.
        lo_model->main_attri_db_save_srtti( ).
        result = xml_of_stored( container = lo_cont
                                model     = lo_model ).
        " the live instance gets its references BACK, not a parsed copy: the
        " same objects the save detached, one assignment each instead of one
        " S-RTTI parse per reference (which is what a fresh container from
        " the draft has to pay, and what this instance never has to)
        lo_model->main_attri_reattach( ).
        RETURN.
      CATCH cx_root INTO lx_first.
        " main_attri_db_save_srtti detached the data references - put them
        " back before the retry below, otherwise the second save would
        " start from the half-cleared app state
        lo_model->main_attri_reattach( ).
    ENDTRY.

    " the one retry that can turn out differently: rows rebuilt from the
    " instance as it is NOW (a reference created after the last dissolve
    " has no row, so its anonymous target went into the asXML and failed
    " there), then saved and serialized again. A bare second stringify of
    " the same rows used to sit here - what the first attempt refused, the
    " same attempt refuses again
    TRY.
        lo_model->main_attri_refresh( ).
        lo_model->main_attri_db_save_srtti( ).
        result = xml_of_stored( container = lo_cont
                                model     = lo_model ).
        lo_model->main_attri_reattach( ).
        RETURN.
      CATCH cx_root.
        " the retry's save detached the references again - put them back
        " like the first CATCH does. The exception below ends THIS request,
        " and in a sticky session the same instance serves the next one,
        " whose main( ) then ran on an app whose data references were
        " initial
        lo_model->main_attri_reattach( ).
    ENDTRY.

    " chain the FIRST serialization failure - it names the attribute/type
    " that is not serializable and carries the source position of the
    " transformation that gave up; the retries fail for the same root cause
    " or a follow-up one.
    " lx_first is always bound here: the only path to this statement runs
    " through the first CATCH, since every success above RETURNs
    RAISE EXCEPTION TYPE z2ui5_cx_ui5_util_error
      EXPORTING
        val      = |APP_SERIALIZATION_ERROR - the app state could not be serialized. | &&
                   |Please check if all generic data references are public attributes of your class|
        previous = lx_first.

  ENDMETHOD.

ENDCLASS.

CLASS z2ui5_cl_ui5_llm_openai IMPLEMENTATION.

  METHOD constructor.

    mv_model               = model.
    mv_api_key             = api_key.
    mv_url                 = url.
    mv_destination         = destination.
    mv_timeout             = COND #( WHEN timeout > 0 THEN timeout ELSE cv_default_timeout ).
    mv_auth_header         = auth_header.
    mv_check_legacy_tokens = check_legacy_tokens.
    IF mv_url IS INITIAL.
      mv_url = COND #( WHEN mv_destination IS INITIAL THEN cv_default_url ELSE cv_default_path ).
    ENDIF.
    IF io_http IS BOUND.
      mi_http = io_http.
    ELSE.
      mi_http = NEW z2ui5_cl_ui5_llm_http( ).
    ENDIF.

  ENDMETHOD.

  METHOD message_push.

    DATA(lo_item) = z2ui5_cl_ui5_ajs=>create_empty( ).
    lo_item->set( iv_path = `/role`
                  iv_val  = role ).
    lo_item->set( iv_path = `/content`
                  iv_val  = content ).
    io_body->push( iv_path = `/messages`
                   iv_val  = lo_item ).

  ENDMETHOD.

  METHOD build_body.

    DATA lv_model TYPE string.
    DATA lv_system TYPE string.

    lv_model = s_options-model.
    IF lv_model IS INITIAL.
      lv_model = mv_model.
    ENDIF.
    z2ui5_cl_ui5_llm_http=>check_call( iv_model       = lv_model
                                       it_message     = t_message
                                       iv_temperature = s_options-temperature
                                       iv_api         = cv_api_name ).
    lv_system = system.

    TRY.
        DATA(lo_body) = z2ui5_cl_ui5_ajs=>create_empty( ).
        lo_body->set( iv_path = `/model`
                      iv_val  = lv_model ).
        IF s_options-max_tokens > 0.
          lo_body->set_integer( iv_path = COND #( WHEN mv_check_legacy_tokens = abap_true
                                                   THEN `/max_tokens`
                                                   ELSE `/max_completion_tokens` )
                                iv_val  = s_options-max_tokens ).
        ENDIF.
        IF s_options-temperature IS NOT INITIAL.
          lo_body->set( iv_path      = `/temperature`
                        iv_val       = s_options-temperature
                        iv_node_type = z2ui5_if_ui5_ajs_types=>node_type-number ).
        ENDIF.
        lo_body->touch_array( `/messages` ).
        " the system prompt is the first message - this API has no field for it
        IF lv_system IS NOT INITIAL.
          message_push( io_body = lo_body
                        role    = `system`
                        content = lv_system ).
        ENDIF.
        LOOP AT t_message INTO DATA(ls_message).
          message_push( io_body = lo_body
                        role    = ls_message-role
                        content = ls_message-content ).
        ENDLOOP.
        result = lo_body->stringify( ).
      CATCH z2ui5_cx_ui5_ajs_error INTO DATA(lx).
        RAISE EXCEPTION TYPE z2ui5_cx_ui5_llm
          EXPORTING
            text     = `the request body could not be written as JSON`
            previous = lx.
    ENDTRY.

  ENDMETHOD.

  METHOD build_request.

    result-body        = build_body( system    = system
                                     t_message = t_message
                                     s_options = s_options ).
    result-url         = mv_url.
    result-destination = mv_destination.
    result-timeout     = mv_timeout.

    INSERT VALUE #( name  = `content-type`
                    value = `application/json; charset=utf-8` ) INTO TABLE result-t_header.
    IF mv_api_key IS NOT INITIAL AND mv_auth_header IS INITIAL.
      INSERT VALUE #( name  = `Authorization`
                      value = |Bearer { mv_api_key }| ) INTO TABLE result-t_header.
    ELSEIF mv_api_key IS NOT INITIAL.
      INSERT VALUE #( name  = mv_auth_header
                      value = mv_api_key ) INTO TABLE result-t_header.
    ENDIF.

  ENDMETHOD.

  METHOD map_stop_reason.

    CASE val.
      WHEN `stop`.
        result = z2ui5_if_ui5_llm=>cs_stop-end_turn.
      WHEN `length`.
        result = z2ui5_if_ui5_llm=>cs_stop-max_tokens.
      WHEN `content_filter`.
        result = z2ui5_if_ui5_llm=>cs_stop-refusal.
      WHEN OTHERS.
        result = val.
    ENDCASE.

  ENDMETHOD.

  METHOD parse_response.

    " OpenAI: {"error":{"message":...}} - Ollama: {"error":"..."}, both read
    " by parse_answer
    DATA(lo_json) = z2ui5_cl_ui5_llm_http=>parse_answer( is_response = is_response
                                                         iv_api      = cv_api_name ).

    result-model                 = lo_json->get_string( `/model` ).
    result-stop_reason           = map_stop_reason( lo_json->get_string( `/choices/1/finish_reason` ) ).
    result-s_usage-input_tokens  = lo_json->get_integer( `/usage/prompt_tokens` ).
    result-s_usage-output_tokens = lo_json->get_integer( `/usage/completion_tokens` ).
    result-text                  = lo_json->get_string( `/choices/1/message/content` ).

    " a declined request: content is null and message.refusal says why -
    " reported like the Claude provider's stop_reason refusal, not as a
    " token limit
    DATA(lv_refusal) = lo_json->get_string( `/choices/1/message/refusal` ).
    IF result-text IS INITIAL AND lv_refusal IS NOT INITIAL.
      " no result-stop_reason here: a RAISE delivers no RETURNING value, so
      " the refusal travels in the exception text alone
      RAISE EXCEPTION TYPE z2ui5_cx_ui5_llm
        EXPORTING
          text        = |the model declined to answer (refusal) - { lv_refusal }|
          http_status = is_response-status.
    ENDIF.
    IF result-text IS INITIAL.
      RAISE EXCEPTION TYPE z2ui5_cx_ui5_llm
        EXPORTING
          text        = |the model returned no text (finish_reason { result-stop_reason }) - raise max_tokens or change the prompt|
          http_status = is_response-status.
    ENDIF.

  ENDMETHOD.

  METHOD z2ui5_if_ui5_llm~chat.

    DATA(ls_request) = build_request( system    = system
                                      t_message = t_message
                                      s_options = s_options ).
    DATA(ls_response) = mi_http->post( ls_request ).
    result = parse_response( ls_response ).

  ENDMETHOD.

ENDCLASS.

CLASS z2ui5_cl_ui5_llm_local IMPLEMENTATION.

  METHOD constructor.

    mt_rule     = t_rule.
    mv_fallback = fallback.

  ENDMETHOD.

  METHOD words.

    DATA lv_text TYPE string.

    lv_text = val.
    lv_text = replace( val  = lv_text
                       sub  = z2ui5_cl_ui5_util_context=>cv_char_util_newline
                       with = ` `
                       occ  = 0 ).
    lv_text = replace( val  = lv_text
                       sub  = z2ui5_cl_ui5_util_context=>cv_char_util_horizontal_tab
                       with = ` `
                       occ  = 0 ).
    lv_text = condense( lv_text ).
    IF lv_text = ``.
      RETURN.
    ENDIF.
    SPLIT lv_text AT ` ` INTO TABLE result.

  ENDMETHOD.

  METHOD count_words.

    result = lines( words( val ) ).

  ENDMETHOD.

  METHOD answer.

    DATA lv_question TYPE string.
    DATA lv_key TYPE string.

    lv_question = to_upper( question ).
    LOOP AT mt_rule INTO DATA(ls_rule).
      IF ls_rule-contains = ``.
        CONTINUE.
      ENDIF.
      lv_key = to_upper( ls_rule-contains ).
      IF lv_question CS lv_key.
        result = ls_rule-answer.
        RETURN.
      ENDIF.
    ENDLOOP.

    result = COND #( WHEN mv_fallback IS INITIAL THEN question ELSE mv_fallback ).

  ENDMETHOD.

  METHOD z2ui5_if_ui5_llm~chat.

    DATA lv_question TYPE string.
    DATA lv_input TYPE string.
    DATA lv_word TYPE string.

    LOOP AT t_message INTO DATA(ls_message).
      lv_input = |{ lv_input } { ls_message-content }|.
      IF ls_message-role = z2ui5_if_ui5_llm=>cs_role-user.
        lv_question = ls_message-content.
      ENDIF.
    ENDLOOP.
    IF lv_question IS INITIAL.
      RAISE EXCEPTION TYPE z2ui5_cx_ui5_llm
        EXPORTING
          text = `a chat call needs a user message with content`.
    ENDIF.
    lv_input = |{ system } { lv_input }|.

    result-model                = cv_model.
    result-stop_reason          = z2ui5_if_ui5_llm=>cs_stop-end_turn.
    result-text                 = answer( lv_question ).
    result-s_usage-input_tokens = count_words( lv_input ).

    DATA(lt_word) = words( result-text ).
    IF s_options-max_tokens > 0 AND lines( lt_word ) > s_options-max_tokens.
      CLEAR result-text.
      LOOP AT lt_word INTO lv_word TO s_options-max_tokens.
        result-text = COND #( WHEN result-text IS INITIAL THEN lv_word ELSE |{ result-text } { lv_word }| ).
      ENDLOOP.
      result-stop_reason = z2ui5_if_ui5_llm=>cs_stop-max_tokens.
    ENDIF.
    result-s_usage-output_tokens = count_words( result-text ).

  ENDMETHOD.

ENDCLASS.

CLASS z2ui5_cl_ui5_llm_http IMPLEMENTATION.

  METHOD check_call.

    IF iv_model IS INITIAL.
      RAISE EXCEPTION TYPE z2ui5_cx_ui5_llm
        EXPORTING
          text = |no model is configured - { iv_api } needs a model id|.
    ENDIF.
    IF lines( it_message ) = 0.
      RAISE EXCEPTION TYPE z2ui5_cx_ui5_llm
        EXPORTING
          text = `a chat call needs at least one message`.
    ENDIF.
    LOOP AT it_message TRANSPORTING NO FIELDS WHERE content IS INITIAL. "#EC CI_SORTSEQ
      RAISE EXCEPTION TYPE z2ui5_cx_ui5_llm
        EXPORTING
          text = |message { sy-tabix } has no content - { iv_api } refuses an empty message|.
    ENDLOOP.
    " The role goes out as it stands, and an app that binds its conversation
    " (to show it in a list) lets the browser write it: a row with the role
    " system is an instruction over the app's own system prompt on every
    " OpenAI-compatible endpoint. The interface allows user and assistant;
    " the system prompt is the parameter system. The value is not echoed -
    " it may come from the request.
    LOOP AT it_message TRANSPORTING NO FIELDS
         WHERE role <> z2ui5_if_ui5_llm=>cs_role-user
           AND role <> z2ui5_if_ui5_llm=>cs_role-assistant. "#EC CI_SORTSEQ
      RAISE EXCEPTION TYPE z2ui5_cx_ui5_llm
        EXPORTING
          text = |message { sy-tabix } has a role other than user or assistant - the system prompt is the parameter system|.
    ENDLOOP.

    IF iv_temperature IS INITIAL.
      RETURN.
    ENDIF.
    " JSON wants a digit on both sides of the point - `.7` and `1.` are no
    " number there - and no leading zero in front of another digit: `01`
    " and `00.5` are no number either
    IF iv_temperature CN `0123456789.`
        OR count( val = iv_temperature
                  sub = `.` ) > 1
        OR iv_temperature CP `.*` OR iv_temperature CP `*.`
        OR ( strlen( iv_temperature ) > 1
             AND substring( val = iv_temperature
                            len = 1 ) = `0`
             AND substring( val = iv_temperature
                            off = 1
                            len = 1 ) <> `.` ).
      RAISE EXCEPTION TYPE z2ui5_cx_ui5_llm
        EXPORTING
          text = |the temperature { iv_temperature } is no number|.
    ENDIF.

  ENDMETHOD.

  METHOD parse_answer.

    DATA lv_message TYPE string.

    TRY.
        result = z2ui5_cl_ui5_ajs=>parse( is_response-body ).
      CATCH cx_root.
        CLEAR result.
    ENDTRY.

    IF is_response-status <> 200.
      IF result IS BOUND.
        " {"error":{"message":...}} - Ollama: {"error":"..."}
        lv_message = result->get_string( `/error/message` ).
        IF lv_message IS INITIAL.
          lv_message = result->get_string( `/error` ).
        ENDIF.
      ENDIF.
      IF lv_message IS INITIAL.
        lv_message = z2ui5_cl_ui5_util_context=>c_truncate( val = is_response-body
                                                           max  = 200 ).
      ENDIF.
      RAISE EXCEPTION TYPE z2ui5_cx_ui5_llm
        EXPORTING
          text        = |{ iv_api } answered HTTP { is_response-status } { is_response-reason } - { lv_message }|
          http_status = is_response-status
          retryable   = xsdbool( is_response-status = 408 OR is_response-status = 429 OR is_response-status >= 500 ).
    ENDIF.

    IF result IS NOT BOUND.
      RAISE EXCEPTION TYPE z2ui5_cx_ui5_llm
        EXPORTING
          text        = |{ iv_api } answered with no JSON|
          http_status = is_response-status.
    ENDIF.

  ENDMETHOD.

  METHOD z2ui5_if_ui5_llm_http~post.

    DATA ls_req TYPE z2ui5_cl_ui5_util_http=>ty_s_client_req.
    DATA ls_res TYPE z2ui5_cl_ui5_util_http=>ty_s_http_res.

    ls_req-method      = `POST`.
    ls_req-url         = is_request-url.
    ls_req-destination = is_request-destination.
    ls_req-body        = is_request-body.
    ls_req-timeout     = is_request-timeout.
    LOOP AT is_request-t_header INTO DATA(ls_header).
      INSERT VALUE #( n = ls_header-name
                      v = ls_header-value ) INTO TABLE ls_req-t_header.
    ENDLOOP.

    TRY.
        ls_res = z2ui5_cl_ui5_util_http=>client_request( ls_req ).
      CATCH cx_root INTO DATA(lx).
        " no answer at all: the destination does not exist, the host cannot
        " be reached, the TLS handshake failed, the timeout ran out - the
        " cause stays in previous, the text is for the person who fixes the
        " setup. Only a failed SEND or RECEIVE is worth another try
        " (HTTP_COMMUNICATION_ERROR, somewhere in the chain): a destination
        " that is not there or not allowed, a client that could not be
        " created, a stack without the client class - "a missing
        " configuration never does" (z2ui5_cx_ui5_llm), and an app looping
        " on retryable retried a call that could never succeed
        DATA(lv_retryable) = abap_false.
        DATA(lx_walk) = lx.
        WHILE lx_walk IS BOUND.
          IF lx_walk->get_text( ) CS `HTTP_COMMUNICATION_ERROR`.
            lv_retryable = abap_true.
            EXIT.
          ENDIF.
          lx_walk = lx_walk->previous.
        ENDWHILE.
        RAISE EXCEPTION TYPE z2ui5_cx_ui5_llm
          EXPORTING
            text      = `the language model endpoint could not be reached - check the destination, the URL, the TLS trust and the proxy`
            retryable = lv_retryable
            previous  = lx.
    ENDTRY.

    result-status = ls_res-status_code.
    result-reason = ls_res-status_reason.
    result-body   = ls_res-body.

  ENDMETHOD.

ENDCLASS.

