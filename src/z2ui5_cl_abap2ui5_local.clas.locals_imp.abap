CLASS z2ui5_cl_ui5_srv_draft DEFINITION FINAL.

  PUBLIC SECTION.

    " The shipped draft store: Z2UI5_T_99, exactly as before. The interface
    " is what lets a host that has no such table supply its own - see there.
    INTERFACES z2ui5_if_ui5_draft_store.

    " No ALIASES - abaplint's no_aliases is an error in this repository, and
    " none are needed: every caller goes through get_instance( ), which hands
    " back an INTERFACE reference, and on one of those the method names are
    " plain. Only a caller holding a concrete z2ui5_cl_ui5_srv_draft would
    " have to qualify, and after this change none does.

    " The two types live on the interface now, with the methods that use them.
    " z2ui5_cl_ui5_srv_draft=>ty_s_draft stays a valid name because of these -
    " z2ui5_cl_ui5_app_cont declares ms_draft with it, and so do test classes.
    TYPES ty_s_db TYPE z2ui5_if_ui5_draft_store=>ty_s_db.
    TYPES ty_s_draft TYPE z2ui5_if_ui5_draft_store=>ty_s_draft.

    "! The longest draft expiry the framework accepts, ten years in hours -
    "! the cleanup turns hours into seconds as an integer, and the shipped
    "! exit clamps what an exit hands back to it
    CONSTANTS c_max_exp_time_in_hours TYPE i VALUE 87600.

    "! The fewest drafts prune_chain( ) keeps of a chain, the one just saved
    "! included. Two, because the frontend may continue the draft BEFORE
    "! the newest one: the retry of a request whose response was lost (the
    "! backend saved depth 1 already, the browser re-sends depth 2), a
    "! request a newer one superseded after the backend had processed it,
    "! and the error overlay's retry after a failed roundtrip all continue
    "! the id the browser adopted last, which the newest save made depth 2.
    "! Everything older is reached only through ids that prune_chain( )
    "! protects (the app stack, route and app state restores, share links).
    CONSTANTS c_min_keep_per_chain TYPE i VALUE 2.

    "! The most drafts prune_chain( ) keeps - the walk is keep - 1 keyed
    "! reads on every save, so a larger value only costs
    CONSTANTS c_max_keep_per_chain TYPE i VALUE 50.

    "! The store the framework uses. Without set_instance( ) this answers a
    "! fresh instance of this class on every call - which is what the call
    "! sites did before the seam existed, so a system that installs nothing
    "! behaves identically, statement for statement.
    CLASS-METHODS get_instance
      RETURNING
        VALUE(result) TYPE REF TO z2ui5_if_ui5_draft_store.

    "! Install a host's own store. Meant for a runtime that is not an SAP
    "! system - a CAP or Node host binding its own persistence at startup -
    "! and for tests. Passing an unbound reference restores the default.
    "! @parameter store | the implementation to use from now on
    CLASS-METHODS set_instance
      IMPORTING
        store TYPE REF TO z2ui5_if_ui5_draft_store.

  PROTECTED SECTION.
    " Unbound unless a host installed one. Deliberately NOT pre-filled with a
    " default instance: the shipped store holds no state, and answering a
    " fresh one keeps the old per-call NEW semantics exactly.
    CLASS-DATA gi_me TYPE REF TO z2ui5_if_ui5_draft_store.

  PRIVATE SECTION.
    CONSTANTS c_seconds_per_hour TYPE i VALUE 3600.

    METHODS read
      IMPORTING
        id             TYPE clike
        check_load_app TYPE abap_bool DEFAULT abap_true
      RETURNING
        VALUE(result)  TYPE ty_s_db.

    " whether prune_chain( ) has to keep the id and end its walk there
    METHODS prune_check_stop
      IMPORTING
        id            TYPE string
        t_stop        TYPE string_table
        t_seen        TYPE string_table
      RETURNING
        VALUE(result) TYPE abap_bool.
ENDCLASS.
CLASS z2ui5_cl_ui5_srv_event DEFINITION FINAL.

  PUBLIC SECTION.
    METHODS get_event
      IMPORTING
        val           TYPE clike                              OPTIONAL
        t_arg         TYPE string_table                       OPTIONAL
        s_cnt         TYPE z2ui5_if_client=>ty_s_event_control OPTIONAL
          PREFERRED PARAMETER val
      RETURNING
        VALUE(result) TYPE string.

    METHODS get_event_client
      IMPORTING
        val           TYPE clike
        view          TYPE clike        DEFAULT z2ui5_if_client=>cs_view-main
        t_arg         TYPE string_table OPTIONAL
      RETURNING
        VALUE(result) TYPE string.

    "! The JSON-array form of a frontend action, as the ajson it is built
    "! in - the response embeds it as a real nested array, so no string
    "! round trip happens on the way out.
    METHODS get_event_client_ajson
      IMPORTING
        val           TYPE clike
        view          TYPE clike        DEFAULT z2ui5_if_client=>cs_view-main
        t_arg         TYPE string_table OPTIONAL
      RETURNING
        VALUE(result) TYPE REF TO z2ui5_if_ui5_ajs.

  PROTECTED SECTION.
    TYPES:
      BEGIN OF ty_s_client_event,
        val   TYPE string,
        t_arg TYPE string_table,
      END OF ty_s_client_event.

    METHODS map_client_event
      IMPORTING
        val           TYPE clike
        view          TYPE clike
        t_arg         TYPE string_table
      RETURNING
        VALUE(result) TYPE ty_s_client_event.

    METHODS get_t_arg
      IMPORTING
        val           TYPE string_table
        iv_literal    TYPE abap_bool DEFAULT abap_false
      RETURNING
        VALUE(result) TYPE string.

    " The arguments as they travel, in BOTH forms of an action - the handler
    " expression of a view (get_t_arg) and the JSON array of a response
    " (get_event_client_ajson): an empty argument between filled ones keeps
    " its position, the empty ones behind the last filled one are dropped.
    " Dropping one in the middle would shift every argument behind it into
    " the wrong slot (a CONTROL_BY_ID action without a view lost its method
    " name this way); keeping one at the end would turn open( ) into
    " open( '' ), because the frontend casts exactly the arguments it was
    " sent. One method, so the two forms cannot come to disagree
    CLASS-METHODS args_trim_trailing
      IMPORTING
        val           TYPE string_table
      RETURNING
        VALUE(result) TYPE string_table.

    " abap_true when an argument goes into the handler expression RAW - a
    " binding, an expression, an event expression - and abap_false when it
    " is quoted as a string. See the method body
    CLASS-METHODS check_arg_raw
      IMPORTING
        val           TYPE string
      RETURNING
        VALUE(result) TYPE abap_bool.

  PRIVATE SECTION.
ENDCLASS.
CLASS z2ui5_cl_ui5_srv_message DEFINITION FINAL CREATE PUBLIC.

  PUBLIC SECTION.

    CONSTANTS:
      "! The texts a box shows when an error carries none of its own.
      "! English like every other text the framework composes (the RAP
      "! fail causes in z2ui5_cl_ui5_util_context=>msg_get_rap_fail_text).
      BEGIN OF cs_text,
        "! nothing to show at all, and the app asked for an error box
        failed        TYPE string VALUE `The operation failed, no further details available`,
        "! one error message without a text and without a T100 key
        error_no_text TYPE string VALUE `Error without message text`,
      END OF cs_text.

    "! Resolve what the message box actually shows. The result carries the
    "! MessageBox display method in `type`, lowercased and guaranteed to be
    "! one the whitelisted global call accepts. `skip` is the one answer
    "! that shows no box: complex data that is initial, handed over with a
    "! type other than `error`.
    CLASS-METHODS box_resolve
      IMPORTING
        text          TYPE any
        type          TYPE clike
        title         TYPE clike
        details       TYPE clike
      RETURNING
        VALUE(result) TYPE z2ui5_cl_ui5_util_context=>ty_s_msg_box.

    "! The MESSAGES in val as one box: type and title from the most severe
    "! one, a single text as it is, several as a counting headline plus a
    "! list in the details. Answers `skip` when nothing in val is a
    "! message - the caller renders the data then.
    CLASS-METHODS box_format_msg
      IMPORTING
        val           TYPE any
      RETURNING
        VALUE(result) TYPE z2ui5_cl_ui5_util_context=>ty_s_msg_box.

    "! The standard text of an error message that carries none, or empty
    "! when msg is not such a message - see the method body for what
    "! counts as one.
    CLASS-METHODS text_default
      IMPORTING
        msg           TYPE z2ui5_cl_ui5_util_context=>ty_s_msg
      RETURNING
        VALUE(result) TYPE string.

  PROTECTED SECTION.
  PRIVATE SECTION.

    "! The sap.m.MessageBox display methods, i.e. the box types the
    "! whitelisted global call accepts. Filled lazily in box_resolve - a
    "! class_constructor would have to be PUBLIC, widening the API for an
    "! internal list.
    CLASS-DATA ct_box_type TYPE string_table.

ENDCLASS.
CLASS z2ui5_cl_ui5_srv_window DEFINITION FINAL CREATE PUBLIC.

  PUBLIC SECTION.

    "! the arguments of cs_event_window as the frontend sends them
    "! (bundle/webapp/core/WindowModel.js): the model path of the table, the
    "! app's event, the reason, skip, top - then, for SORT and FILTER, the
    "! sorters and the filter groups as JSON
    CLASS-METHODS request
      IMPORTING
        t_arg         TYPE string_table
      RETURNING
        VALUE(result) TYPE z2ui5_if_client=>ty_s_window_request.

    "! the app's event of a window request - the second argument
    CLASS-METHODS event
      IMPORTING
        t_arg         TYPE string_table
      RETURNING
        VALUE(result) TYPE string.

    "! the sorters as the frontend sends them:
    "! `[{"PATH":"NAME","DESCENDING":true}, ...]`
    CLASS-METHODS parse_sort
      IMPORTING
        val           TYPE string
      RETURNING
        VALUE(result) TYPE z2ui5_if_client=>ty_t_bind_tab_sort.

    "! the filter as the frontend sends it - the groups (ANDed), each an
    "! array of conditions (ORed), each `[path, operator, value1, value2]`:
    "! `[[["NAME","Contains","ab"]],[["PRICE","GT",100]]]`
    CLASS-METHODS parse_filter
      IMPORTING
        val           TYPE string
      RETURNING
        VALUE(result) TYPE z2ui5_if_client=>ty_t_bind_tab_filter.

  PROTECTED SECTION.
  PRIVATE SECTION.

    "! a count from the browser: condensed, digits only and nine of them at
    "! most - anything else is 0. The request comes from the browser, and a
    "! value that only sizes the window must not end the request with a dump
    CLASS-METHODS count_of
      IMPORTING
        val           TYPE string
      RETURNING
        VALUE(result) TYPE i.

    "! a sorter's or a condition's path that can name a component of a row:
    "! not empty, and nothing but A-Z, 0-9, _ and / (a namespace, a
    "! sub-component). The app puts it into an ORDER BY or a WHERE - often a
    "! dynamic one - so a path that could not be a component is dropped here
    "! instead of reaching it as written by the browser
    CLASS-METHODS path_valid
      IMPORTING
        val           TYPE string
      RETURNING
        VALUE(result) TYPE abap_bool.

    "! an operator of the documented list (ty_s_bind_tab_filter) - the
    "! sap.ui.model.FilterOperator values; anything else is dropped
    CLASS-METHODS operator_valid
      IMPORTING
        val           TYPE string
      RETURNING
        VALUE(result) TYPE abap_bool.

ENDCLASS.
CLASS z2ui5_cl_ui5_util_http DEFINITION.

  PUBLIC SECTION.

    TYPES:
      BEGIN OF ty_s_http_req,
        method   TYPE string,
        body     TYPE string,
        path     TYPE string,
        t_params TYPE z2ui5_cl_ui5_util_context=>ty_t_name_value,
        " the raw query string t_params was parsed from, see get_query
        query    TYPE string,
      END OF ty_s_http_req.

    TYPES:
      BEGIN OF ty_s_http_res,
        body          TYPE string,
        status_code   TYPE i,
        status_reason TYPE string,
      END OF ty_s_http_res.

    " Outbound-HTTP utility surface vendored from abap-util for APP code and
    " kept in the catalog sync. client_call has a caller outside this
    " repository: the consumer side of abap2UI5-addons/http-connector
    " forwards every request through it, which is also why it takes a query.
    " Dropping or narrowing either of the two breaks that addon. Inside the
    " repository the language model transport (z2ui5_cl_ui5_llm_http) calls
    " client_request, the general form below, which client_call wraps
    CLASS-METHODS client_create
      IMPORTING
        !destination  TYPE clike OPTIONAL
        url           TYPE clike OPTIONAL
      RETURNING
        VALUE(result) TYPE REF TO object.

    CLASS-METHODS client_call
      IMPORTING
        !method       TYPE clike
        body          TYPE clike OPTIONAL
        !destination  TYPE clike OPTIONAL
        url           TYPE clike OPTIONAL
        !query        TYPE clike OPTIONAL
      RETURNING
        VALUE(result) TYPE ty_s_http_res.

    " One outbound HTTP request with header fields and a timeout - the general
    " form of client_call, which builds this structure and calls it. url is
    " the full URL, or with destination the path below it; t_header carries
    " the request header fields (content-type among them); timeout in
    " seconds, 0 for the client's default. The platform decides the client
    " (z2ui5_cl_ui5_util_context=>check_abap_cloud): CL_HTTP_CLIENT with an
    " SM59 destination or a URL on Standard, CL_WEB_HTTP_CLIENT_MANAGER on
    " ABAP Cloud with a URL, a communication arrangement
    " (SCENARIO/SERVICE_ID[/COMM_SYSTEM]) or a destination of the BTP
    " destination service (any other name). Both named dynamically, so the
    " class activates on every release. The one caller in this repository is
    " z2ui5_cl_ui5_llm_http, the transport of the language model providers
    TYPES:
      BEGIN OF ty_s_client_req,
        method      TYPE string,
        url         TYPE string,
        destination TYPE string,
        query       TYPE string,
        body        TYPE string,
        t_header    TYPE z2ui5_cl_ui5_util_context=>ty_t_name_value,
        timeout     TYPE i,
      END OF ty_s_client_req.

    CLASS-METHODS client_request
      IMPORTING
        is_req        TYPE ty_s_client_req
      RETURNING
        VALUE(result) TYPE ty_s_http_res.

    CLASS-METHODS factory
      IMPORTING
        server        TYPE REF TO object
      RETURNING
        VALUE(result) TYPE REF TO z2ui5_cl_ui5_util_http.

    CLASS-METHODS factory_cloud
      IMPORTING
        req           TYPE REF TO object
        res           TYPE REF TO object
      RETURNING
        VALUE(result) TYPE REF TO z2ui5_cl_ui5_util_http.

    METHODS get_req_info
      RETURNING
        VALUE(result) TYPE ty_s_http_req.

    " the query string of the request, raw - everything after the FIRST `?`
    " of its URI, not decoded. What a proxy forwards: parsing it into
    " t_params and encoding it again is not guaranteed to give the same
    " string back (sap-startup-params, see url_param_get_tab)
    METHODS get_query
      RETURNING
        VALUE(result) TYPE string.

    METHODS get_header_field
      IMPORTING
        val           TYPE clike
      RETURNING
        VALUE(result) TYPE string.

    METHODS get_cdata
      RETURNING
        VALUE(result) TYPE string.

    METHODS get_method
      RETURNING
        VALUE(result) TYPE string.

    METHODS set_cdata
      IMPORTING
        val TYPE clike.

    METHODS set_status
      IMPORTING
        !code  TYPE i
        reason TYPE clike.

    METHODS set_session_stateful
      IMPORTING
        val TYPE i.

    METHODS get_response_cookie
      IMPORTING
        val           TYPE clike
      RETURNING
        VALUE(result) TYPE string.

    METHODS delete_response_cookie
      IMPORTING
        val TYPE clike.

    METHODS set_header_field
      IMPORTING
        !n TYPE clike
        v  TYPE clike.

    DATA mo_server_onprem  TYPE REF TO object.
    DATA mo_request_cloud  TYPE REF TO object.
    DATA mo_response_cloud TYPE REF TO object.

  PROTECTED SECTION.

  PRIVATE SECTION.

    " the shape of IF_WEB_HTTP_RESPONSE=>HTTP_STATUS, declared here because
    " the interface is not on every release - a dynamic RECEIVING needs a
    " structurally identical target
    TYPES:
      BEGIN OF ty_s_http_status_cloud,
        code   TYPE i,
        reason TYPE string,
      END OF ty_s_http_status_cloud.

    TYPES:
      BEGIN OF ty_s_client_target,
        url         TYPE string,
        request_uri TYPE string,
      END OF ty_s_client_target.

    CLASS-METHODS client_request_std
      IMPORTING
        is_req        TYPE ty_s_client_req
      RETURNING
        VALUE(result) TYPE ty_s_http_res.

    CLASS-METHODS client_send_std
      IMPORTING
        io_client   TYPE REF TO object
        is_req      TYPE ty_s_client_req
        request_uri TYPE string.

    CLASS-METHODS client_request_cloud
      IMPORTING
        is_req        TYPE ty_s_client_req
      RETURNING
        VALUE(result) TYPE ty_s_http_res.

    CLASS-METHODS client_execute_cloud
      IMPORTING
        io_client     TYPE REF TO object
        method        TYPE any
        timeout       TYPE i
      RETURNING
        VALUE(result) TYPE REF TO object.

    CLASS-METHODS client_destination_cloud
      IMPORTING
        is_req        TYPE ty_s_client_req
      RETURNING
        VALUE(result) TYPE REF TO object.

    " where client_call puts its query - see the method
    CLASS-METHODS client_target
      IMPORTING
        !destination  TYPE clike
        url           TYPE clike
        !query        TYPE clike
      RETURNING
        VALUE(result) TYPE ty_s_client_target.

    " resolved once per instance - every accessor would otherwise repeat
    " the dynamic ASSIGN on the server object
    DATA mo_request_onprem  TYPE REF TO object.
    DATA mo_response_onprem TYPE REF TO object.

    METHODS get_request_onprem
      RETURNING
        VALUE(result) TYPE REF TO object.

    METHODS get_response_onprem
      RETURNING
        VALUE(result) TYPE REF TO object.

ENDCLASS.
