    mo_frontend->slot_destroy( z2ui5_if_client=>cs_view-nested ).

  ENDMETHOD.
  METHOD z2ui5_if_client~nest_view_display.

    mo_frontend->slot_display( slot           = z2ui5_if_client=>cs_view-nested
                               xml            = val
                               id             = id
