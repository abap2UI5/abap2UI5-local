  METHOD z2ui5_if_ajson~get_number.

    DATA lr_item TYPE REF TO z2ui5_if_ajson_types=>ty_node.
    lr_item = get_item( iv_path ).
    IF lr_item IS NOT INITIAL AND lr_item->type = z2ui5_if_ajson_types=>node_type-number.
