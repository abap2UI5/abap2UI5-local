  METHOD z2ui5_if_ui5_ajs~push.

    DATA lr_parent TYPE REF TO z2ui5_if_ui5_ajs_types=>ty_node.
    DATA lr_new_node TYPE REF TO z2ui5_if_ui5_ajs_types=>ty_node.

    read_only_watchdog( ).

    lr_parent = get_item( iv_path ).

    IF lr_parent IS INITIAL.
      z2ui5_cx_ui5_ajs_error=>raise( |Path [{ iv_path }] does not exist| ).
    ENDIF.

    IF lr_parent->type <> z2ui5_if_ui5_ajs_types=>node_type-array.
      z2ui5_cx_ui5_ajs_error=>raise( |Path [{ iv_path }] is not array| ).
    ENDIF.

    DATA lt_new_nodes TYPE z2ui5_if_ui5_ajs_types=>ty_nodes_tt.
    DATA ls_new_path TYPE z2ui5_if_ui5_ajs_types=>ty_path_name.
    DATA lv_new_index TYPE i.

    lv_new_index     = lr_parent->children + 1.
    ls_new_path-path = kHGwlyRcRdfnyozImyabzByNvbZmNu=>normalize_path( iv_path ).
    ls_new_path-name = |{ lv_new_index }|.

    lt_new_nodes = kHGwlyRcRdfnyozImyabeJqampzabz=>convert(
      is_opts            = ms_opts
      iv_data   = iv_val
      is_prefix = ls_new_path ).
    READ TABLE lt_new_nodes INDEX 1 REFERENCE INTO lr_new_node. " assume first record is the array item - not ideal !
    ASSERT sy-subrc = 0.
    lr_new_node->index = lv_new_index.

    " update data
    lr_parent->children = lv_new_index.
    INSERT LINES OF lt_new_nodes INTO TABLE mt_json_tree.

    ri_json = me.

  ENDMETHOD.
  METHOD z2ui5_if_ui5_ajs~set.

    DATA ls_split_path TYPE z2ui5_if_ui5_ajs_types=>ty_path_name.
    DATA lr_parent TYPE REF TO z2ui5_if_ui5_ajs_types=>ty_node.
    DATA ls_deleted_node TYPE z2ui5_if_ui5_ajs_types=>ty_node.
    DATA lv_item_order TYPE z2ui5_if_ui5_ajs_types=>ty_node-order.

    read_only_watchdog( ).

    ri_json = me.

    IF iv_val IS INITIAL AND iv_ignore_empty = abap_true AND iv_node_type IS INITIAL.
      RETURN. " nothing to assign
    ENDIF.

    IF iv_node_type IS NOT INITIAL
      AND iv_node_type <> z2ui5_if_ui5_ajs_types=>node_type-boolean AND iv_node_type <> z2ui5_if_ui5_ajs_types=>node_type-null
      AND iv_node_type <> z2ui5_if_ui5_ajs_types=>node_type-number AND iv_node_type <> z2ui5_if_ui5_ajs_types=>node_type-string.
      z2ui5_cx_ui5_ajs_error=>raise( |Unexpected type { iv_node_type }| ).
    ENDIF.

    ls_split_path = kHGwlyRcRdfnyozImyabzByNvbZmNu=>split_path( iv_path ).
    IF ls_split_path IS INITIAL. " Assign root, exceptional processing
      IF iv_node_type IS NOT INITIAL.
        mt_json_tree = kHGwlyRcRdfnyozImyabeJqampzabz=>insert_with_type(
          is_opts            = ms_opts
          iv_data            = iv_val
          iv_type            = iv_node_type
          is_prefix          = ls_split_path
          ii_custom_mapping  = mi_custom_mapping ).
      ELSE.
        mt_json_tree = kHGwlyRcRdfnyozImyabeJqampzabz=>convert(
          is_opts            = ms_opts
          iv_data            = iv_val
          is_prefix          = ls_split_path
          ii_custom_mapping  = mi_custom_mapping ).
      ENDIF.
      RETURN.
    ENDIF.

    " Ensure whole path exists
    lr_parent = prove_path_exists( ls_split_path-path ).
    ASSERT lr_parent IS NOT INITIAL.

    " delete if exists with subtree
    ls_deleted_node = delete_subtree(
      ir_parent = lr_parent
      iv_path   = ls_split_path-path
      iv_name   = ls_split_path-name ).
    lv_item_order = ls_deleted_node-order.

    " convert to json
    DATA lt_new_nodes TYPE z2ui5_if_ui5_ajs_types=>ty_nodes_tt.
    DATA lv_array_index TYPE i.

    IF lr_parent->type = z2ui5_if_ui5_ajs_types=>node_type-array.
      lv_array_index = kHGwlyRcRdfnyozImyabzByNvbZmNu=>validate_array_index(
        iv_path  = ls_split_path-path
        iv_index = ls_split_path-name ).
    ELSEIF lr_parent->type = z2ui5_if_ui5_ajs_types=>node_type-object
      AND lv_item_order = 0 AND ms_opts-keep_item_order = abap_true.
      lv_item_order = lr_parent->children + 1.
    ENDIF.

    IF iv_node_type IS NOT INITIAL.
      lt_new_nodes = kHGwlyRcRdfnyozImyabeJqampzabz=>insert_with_type(
        is_opts            = ms_opts
        iv_item_order      = lv_item_order
        iv_data            = iv_val
        iv_type            = iv_node_type
        iv_array_index     = lv_array_index
        is_prefix          = ls_split_path
        ii_custom_mapping  = mi_custom_mapping ).
    ELSE.
      lt_new_nodes = kHGwlyRcRdfnyozImyabeJqampzabz=>convert(
        is_opts            = ms_opts
        iv_item_order      = lv_item_order
        iv_data            = iv_val
        iv_array_index     = lv_array_index
        is_prefix          = ls_split_path
        ii_custom_mapping  = mi_custom_mapping ).
    ENDIF.

    " update nodes
    IF lines( lt_new_nodes ) > 0.
      lr_parent->children = lr_parent->children + 1.
      INSERT LINES OF lt_new_nodes INTO TABLE mt_json_tree.
    ENDIF.

  ENDMETHOD.
  METHOD z2ui5_if_ui5_ajs~setx.

    DATA lv_path TYPE string.
    DATA lv_val TYPE string.
    DATA lv_int TYPE i.
    DATA lv_dec TYPE decfloat34.
    DATA lv_last TYPE i.

    IF iv_param IS INITIAL.
      ri_json = me.
      RETURN.
    ENDIF.

    SPLIT iv_param AT ':' INTO lv_path lv_val.
    CONDENSE lv_path.
    CONDENSE lv_val.

    IF lv_val IS INITIAL.
      ri_json = me.
      RETURN. " Hmm ? or empty string ? or null ?
    ENDIF.

    IF go_float_regex IS NOT BOUND.
      CREATE OBJECT go_float_regex EXPORTING pattern = '^([1-9][0-9]*|0)\.[0-9]+$' ##REGEX_POSIX.
      " expects fractional, because ints are detected separately
    ENDIF.

    IF lv_val = 'null'.
      z2ui5_if_ui5_ajs~set_null( lv_path ).
    ELSEIF lv_val = 'true'.
      z2ui5_if_ui5_ajs~set_boolean(
        iv_path = lv_path
        iv_val  = abap_true ).
    ELSEIF lv_val = 'false'.
      z2ui5_if_ui5_ajs~set_boolean(
        iv_path = lv_path
        iv_val  = abap_false ).
    ELSEIF lv_val CO '0123456789'.
      lv_int = lv_val.
      z2ui5_if_ui5_ajs~set_integer(
        iv_path = lv_path
        iv_val  = lv_int ).
    ELSEIF lv_val CO '0123456789.' AND go_float_regex->create_matcher( text = lv_val )->match( ) = abap_true.
      lv_dec = lv_val.
      z2ui5_if_ui5_ajs~set(
        iv_path = lv_path
        iv_val  = lv_dec ).
    ELSEIF lv_val+0(1) = '{' OR lv_val+0(1) = '['.
      "Expect object/array, but no further checks, parser will catch errors
      z2ui5_if_ui5_ajs~set(
        iv_path = lv_path
        iv_val  = parse(
          iv_json = lv_val
          iv_keep_item_order = ms_opts-keep_item_order ) ).
    ELSE. " string
      lv_last = strlen( lv_val ) - 1.
      IF lv_val+0(1) = '"' AND lv_val+lv_last(1) = '"'.
        lv_val = substring(
          val = lv_val
          off = 1
          len = lv_last - 1 ).
      ENDIF.
      z2ui5_if_ui5_ajs~set_string(
        iv_path = lv_path
        iv_val  = lv_val ).
    ENDIF.

    ri_json = me.

  ENDMETHOD.
