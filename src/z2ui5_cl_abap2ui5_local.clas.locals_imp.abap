  METHOD z2ui5_if_ui5_ajs~get_date.

    DATA lr_item TYPE REF TO z2ui5_if_ui5_ajs_types=>ty_node.
    DATA lv_y TYPE c LENGTH 4.
    DATA lv_m TYPE c LENGTH 2.
    DATA lv_d TYPE c LENGTH 2.

