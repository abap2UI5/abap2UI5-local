    "! the unit specs that pin the TEXT form of a client event.
    METHODS get_event_client_json
      IMPORTING
        val           TYPE clike
        view          TYPE clike        DEFAULT z2ui5_if_client=>cs_view-main
        t_arg         TYPE string_table OPTIONAL
